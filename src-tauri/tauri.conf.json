{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SIP Softphone",
  "version": "0.1.0",
  "identifier": "dev.jeremiah.sipsoftphone",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "SIP Softphone",
        "width": 360,
        "height": 640,
        "minWidth": 320,
        "minHeight": 520,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["tel", "sip", "sips", "callto"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkxQTY1RDVCMzNFMjU5M0YKUldRL1dlSXpXMTJta1M3anFjN1ZobzBlQmdEMkxocy85OUwrc1pGZkdiS0hiMWwxUk5iTHM0K0cK",
      "endpoints": ["https://github.com/jeremiahjohnston/sip-softphone/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "macOS": {
      "infoPlist": "Info.plist",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    }
  }
}
